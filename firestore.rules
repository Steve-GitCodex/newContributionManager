rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function uid() {
      return isSignedIn() ? request.auth.uid : '__anonymous__';
    }

    function isSuperadmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/superadminUsers/$(uid()));
    }

    function orgRole(orgId) {
      let membership = get(/databases/$(database)/documents/organizations/$(orgId)/users/$(uid()));
      return membership != null ? membership.data.get('role', '') : '';
    }

    function isMember(orgId) {
      return orgRole(orgId) != '';
    }

    function isOrgAdmin(orgId) {
      return orgRole(orgId) == 'admin';
    }

    function isOrgStaff(orgId) {
      return orgRole(orgId) in ['admin', 'editor'];
    }

    match /systemConfig/setup {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSuperadmin();
    }

    // Bootstrap only: once systemConfig/setup exists the gate closes for good, so a
    // signed-in user can never promote themselves. Later superadmins are added out of
    // band with the Admin SDK.
    match /superadminUsers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/systemConfig/setup);
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperadmin());
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSuperadmin();
    }

    match /userOrganizations/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isSuperadmin();
    }

    match /organizations/{orgId}/users/{uid} {
      allow read: if isMember(orgId) || isSuperadmin();
      allow create, update: if (isOrgAdmin(orgId) || isSuperadmin())
        && request.resource.data.role in ['admin', 'editor', 'viewer'];
      allow delete: if isOrgAdmin(orgId) || isSuperadmin();
    }

    // One ledger per organization (`budgets/org`), not one per person: expenses are set
    // against org-wide contribution income, and only an admin records them.
    match /organizations/{orgId}/budgets/{budgetId} {
      allow read: if isMember(orgId) || isSuperadmin();
      allow write: if isOrgAdmin(orgId) || isSuperadmin();
    }

    match /organizations/{orgId}/{adminOnly}/{docId} {
      allow read: if (isMember(orgId) || isSuperadmin())
        && adminOnly in ['blacklist', 'settings'];
      allow write: if (isOrgAdmin(orgId) || isSuperadmin())
        && adminOnly in ['blacklist', 'settings'];
    }

    match /organizations/{orgId}/{staffWritable}/{docId} {
      allow read: if (isMember(orgId) || isSuperadmin())
        && staffWritable in ['contributions', 'campaigns', 'campaignContributions', 'members', 'months', 'meta'];
      allow write: if (isOrgStaff(orgId) || isSuperadmin())
        && staffWritable in ['contributions', 'campaigns', 'campaignContributions', 'members', 'months', 'meta'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
